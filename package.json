{
  "name": "deskflow",
  "version": "0.1.0",
  "description": "A local-first personal workbench built with Electron and React",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:state && npm run test:focus && npm run test:tasks && npm run test:feeds",
    "test:feeds": "node tests/feeds.cjs",
    "test:focus": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/focus-timer.mjs tests/focus-sessions.mjs",
    "test:tasks": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/task-dates.mjs tests/task-focus-history.mjs",
    "test:state": "node --test tests/state-store.cjs tests/state-migration.cjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
